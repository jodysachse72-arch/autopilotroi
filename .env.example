# AutopilotROI — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (Email Notifications) ──────────────────────────────────────────────
# Get API key from: resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional: custom from address (requires verified domain in Resend)
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Cloudflare Turnstile (Bot Protection on /signup) ──────────────────────────
# Get keys from: dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Puck CMS Write Protection ─────────────────────────────────────────────────
# TEMPORARY stabilization protection for /api/puck write endpoints.
# Replace with Supabase session/role auth during the auth hardening sprint.
# Must use NEXT_PUBLIC_ prefix so the editor client page can send it as a header.
# Generate a secure random value: openssl rand -hex 32
NEXT_PUBLIC_PUCK_WRITE_SECRET=replace-me

# ── ThriveDesk (Helpdesk Integration) ─────────────────────────────────────────
# Stubbed until credentials are set. The adapter no-ops cleanly without a key.
# Supabase is the durable store; ThriveDesk is a secondary dual-write.
# THRIVEDESK_API_KEY=your-thrivedesk-api-key
# THRIVEDESK_INBOX_ID=your-inbox-id
